# Copy this file to .env.local (git-ignored via *.local) and fill in the team key.
# The key is read only by the Vite dev/preview proxy (vite.config.ts) and is
# never bundled into the browser code.
HAI_API_KEY=
# The single model used by all AI calls. There is no model selector in the UI.
HAI_MODEL=vllm/Kolibri-1
# Optional: override the gateway base URL (without /v1).
# HAI_API_BASE=https://hip-gw.hessian.ai
